{
    "doctype": "DocType",
    "name": "Expense",
    "module": "Expenso",
    "engine": "InnoDB",
    "autoname": "hash",
    "fields": [
        {
            "fieldname": "amount",
            "fieldtype": "Float",
            "label": "Amount",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "date",
            "fieldtype": "Date",
            "label": "Date",
            "default": "Today",
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "category",
            "fieldtype": "Link",
            "label": "Category",
            "options": "Category",
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "family",
            "fieldtype": "Link",
            "label": "Family",
            "options": "Family",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "Family Member",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        }
    ]
}

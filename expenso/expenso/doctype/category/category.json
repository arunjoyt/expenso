{
    "doctype": "DocType",
    "name": "Category",
    "module": "Expenso",
    "engine": "InnoDB",
    "autoname": "format:CAT-{####}",
    "naming_rule": "Expression",
    "title_field": "category_name",
    "show_title_field_in_link": 1,
    "fields": [
        {
            "fieldname": "category_name",
            "fieldtype": "Data",
            "label": "Category Name",
            "reqd": 1
        },
        {
            "fieldname": "family",
            "fieldtype": "Link",
            "label": "Family",
            "options": "Family",
            "reqd": 1,
            "in_list_view": 1,
            "in_standard_filter": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1
        },
        {
            "role": "Family Member",
            "read": 1,
            "write": 1,
            "create": 1
        }
    ]
}
